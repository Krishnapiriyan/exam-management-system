# Database (Supabase / Neon connection string)
DATABASE_URL="postgresql://user:password@host:port/dbname?pgbouncer=true"

# JWT
JWT_SECRET="YourLongRandomSecretKeyForProduction"
JWT_EXPIRES_IN="7d"

# Cloudinary (Frontend assets)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 (PDF Storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ems"
R2_PUBLIC_URL=""

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="onboarding@resend.dev"

# Server (Production)
PORT=5000
CLIENT_URL="https://admin.yourdomain.com"
USER_CLIENT_URL="https://students.yourdomain.com"
